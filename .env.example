# ============================================================
#  Configuration — copiez ce fichier en .env et adaptez-le
# ============================================================

# Titre affiché dans l'interface
SITE_TITLE=Prépa TSI · Cours

# Consultation : true = publique (tout le monde peut lire/télécharger)
#                false = privée (connexion obligatoire, comptes "viewer" possibles)
# Dans tous les cas, upload / suppression / création sont réservés aux admins.
PUBLIC_READ=true

# Compte administrateur créé au PREMIER démarrage uniquement.
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est affiché dans les logs
# (docker compose logs app). Changez-le ensuite depuis l'interface.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Derrière un reverse-proxy HTTPS (production) ---
# URL publique exacte du site (sert à la vérification anti-CSRF de l'en-tête Origin)
APP_ORIGIN=https://cours.exemple.fr
# Nombre de proxys de confiance devant l'application (1 pour Nginx/Traefik/cloudflared)
TRUST_PROXY=1
# Cookie "Secure" (+ HSTS) : laissez true en production avec HTTPS.
# Mettez false UNIQUEMENT pour un test local en http://localhost.
COOKIE_SECURE=true

# Durée de validité d'une session (heures)
SESSION_TTL_HOURS=24
# Tentatives de connexion échouées autorisées par IP et par 15 minutes
LOGIN_RATE_LIMIT=10

# Uploads
MAX_UPLOAD_MB=100
MAX_FILES_PER_UPLOAD=50
# Extensions autorisées (séparées par des virgules). Seuls PDF et images sont
# affichés dans le navigateur ; le reste est toujours proposé en téléchargement.
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,gif,txt,md,tex,py,ipynb,csv,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,zip
